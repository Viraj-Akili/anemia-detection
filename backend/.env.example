# PRAHARI Backend — environment configuration template
# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# PostgreSQL password used by both the db and api containers
POSTGRES_PASSWORD=CHANGE_ME

# DATABASE_URL is auto-assembled in docker-compose.yml, but you can override it here.
# Inside Docker the hostname must be 'db', not 'localhost'.
DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/prahari

ENVIRONMENT=development
DEBUG=true
