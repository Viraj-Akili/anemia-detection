# PRAHARI AI/CV Backend — Environment Configuration
# Copy to .env and adjust as needed. No real secrets exist in this project.

# --- Model ---
# AI_MODEL=random_forest          # "random_forest" (primary) | "cnn" (fallback)
# ANEMIA_MODEL_PATH=models/baseline_classifier.joblib
# ANEMIA_CNN_MODEL_PATH=models/mobilenetv2_best.pth
# CONFIDENCE_THRESHOLD=0.5

# --- Image ---
# IMAGE_SIZE=224
# MAX_IMAGE_SIZE=4096            # max long-side of uploaded image (px)

# --- Quality Gate (calibrated against CP-AnemiC data) ---
# QUALITY_MIN_BRIGHTNESS=30
# QUALITY_MAX_BRIGHTNESS=250
# QUALITY_MIN_SHARPNESS=50
# QUALITY_MIN_CONTRAST=10
# QUALITY_MIN_TISSUE_FRACTION=0.10
# QUALITY_MIN_RESOLUTION=16

# --- Data Pipeline ---
# DATA_SEED=42
# DATA_RAW_DIR=data/raw
# DATA_PROCESSED_DIR=data/processed

# --- Device ---
# DEVICE=auto                    # "auto" | "cuda" | "cpu"

# --- API ---
# API_TITLE=PRAHARI Anemia Screening API
# API_VERSION=0.1.0
# MAX_IMAGE_SIZE_MB=4            # upload safety limit (MB)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
